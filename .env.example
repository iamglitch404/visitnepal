# ==============================================================================
# VISITNEPAL PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment: 'development' | 'staging' | 'production'
NODE_ENV=development
PORT=8080

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In PRODUCTION, this MUST point to a highly-available managed PostgreSQL instance.
# (e.g. Supabase, AWS RDS, GCP Cloud SQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_DB_HOST:5432/postgres

# Database Pool Tuning
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=15000
DB_CONNECTION_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a strong 256-bit random string for JWT signing: openssl rand -base64 32
JWT_SECRET=production_super_secret_jwt_key_nepal_tourism_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated in production)
ALLOWED_ORIGINS=https://visitnepal.gov.np,https://app.visitnepal.com

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY INTEGRATIONS (NEPAL & INTERNATIONAL)
# ------------------------------------------------------------------------------

# 1. Khalti ePayment Gateway (Nepal Rupee - NPR)
# Register at: https://admin.khalti.com
KHALTI_PUBLIC_KEY=live_public_key_your_khalti_merchant_key
KHALTI_SECRET_KEY=live_secret_key_your_khalti_merchant_secret
KHALTI_BASE_URL=https://khalti.com/api/v2

# 2. eSewa Mobile Wallet (Nepal Rupee - NPR)
# Register at: https://merchant.esewa.com.np
ESEWA_MERCHANT_CODE=YOUR_REGISTERED_MERCHANT_CODE
ESEWA_SECRET_KEY=YOUR_MERCHANT_HMAC_SECRET_KEY
ESEWA_URL=https://epay.esewa.com.np/api/epay/main/v2/form

# 3. Stripe International Payments (Credit/Debit Card - USD, EUR, GBP)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
# Local directory or AWS S3 / Cloudflare R2 bucket for secure permits & business KYC
STORAGE_PROVIDER=local
STORAGE_BUCKET=visitnepal-protected-documents
PUBLIC_APP_URL=https://visitnepal.gov.np

# ------------------------------------------------------------------------------
# EMAIL & SMS NOTIFICATIONS (ALERTS & 2FA)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
SMTP_FROM=no-reply@visitnepal.gov.np

SMS_GATEWAY_API_KEY=YOUR_NCELL_OR_SPARROW_SMS_TOKEN
